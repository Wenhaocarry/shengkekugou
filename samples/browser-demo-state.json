  "songs": [
    {
      "id": "demo-a",
      "title": "慢慢抵达",
      "artist": "声刻 · 原创合成演示音",
      "duration": 40,
      "audio_url": "/media/sample-a.wav",
      "cover_url": "",
      "color": "#a6c8b8",
      "lyrics": [
        {
          "time": 0,
          "text": "出发之前，把心事收进口袋"
        },
        {
          "time": 8,
          "text": "城市的风，吹过陌生的站台"
        },
        {
          "time": 16,
          "text": "慢慢抵达，也慢慢找到自己"
        },
        {
          "time": 24,
          "text": "总有一盏灯，会为今天亮起"
        },
        {
          "time": 32,
          "text": "这一路，值得好好记住"
        }
      ],
      "sample": true,
      "created_at": "2026-10-20T07:30:47Z"
    },
    {
      "id": "demo-b",
      "title": "把今天留住",
      "artist": "声刻 · 原创合成演示音",
      "duration": 40,
      "audio_url": "/media/sample-b.wav",
      "cover_url": "",
      "color": "#c9b7e2",
      "lyrics": [
        {
          "time": 0,
          "text": "给平凡的一天，留一束光"
        },
        {
          "time": 8,
          "text": "那些小事，都有回响"
        },
        {
          "time": 16,
          "text": "把今天留住，把温柔带走"
        },
        {
          "time": 24,
          "text": "不必赶路，也可以抬头"
        },
        {
          "time": 32,
          "text": "你也在好好生活"
        }
      ],
      "sample": true,
      "created_at": "2026-10-20T07:30:47Z"
    },
    {
      "id": "demo-c",
      "title": "日落之前",
      "artist": "声刻 · 原创合成演示音",
      "duration": 40,
      "audio_url": "/media/sample-c.wav",
      "cover_url": "",
      "color": "#e7ba91",
      "lyrics": [
        {
          "time": 0,
          "text": "在日落之前，绕一段路"
        },
        {
          "time": 8,
          "text": "让晚风替我，轻轻停驻"
        },
        {
          "time": 16,
          "text": "风经过河边，也经过你"
        },
        {
          "time": 24,
          "text": "一首歌，一段记得的风景"
        },
        {
          "time": 32,
          "text": "明天见，今天的自己"
        }
      ],
      "sample": true,
      "created_at": "2026-10-20T07:30:47Z"
    },
